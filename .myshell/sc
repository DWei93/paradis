#!/bin/bash

#   WDA
HelpMessages () {
    echo "sc:          send code and record log messages"
    echo "command:  sc [-h] [-r|--record (.log/history.log)]"
    echo "             [-o|--cpopt (fr)] [-b|--basename (paradis)]"
    echo "             [-n|--number|--numbers (NULL)]: comma-separated"
    echo "             [-m|--message ]"
    echo "             [-j|--jobmes ]"
    echo "             [-x|--basejobname (WLY) ]"
}

CopyCodes () {
    local DirName=$1
    local OPT=$2
    
    if [ ! -d $DirName ]; then
        mkdir $DirName
    fi
    if [ ! -d $DirName/src ]; then
        mkdir $DirName/src
    fi
    if [ ! -d $DirName/utilities ]; then
        mkdir $DirName/utilities
    fi
    if [ ! -d $DirName/include ]; then
        mkdir $DirName/include
    fi
    if [ ! -d $DirName/input ]; then
        mkdir $DirName/input
    fi

    cp include/*.h ${DirName}/include $OPT
    cp src/* ${DirName}/src $OPT
    cp utilities/* ${DirName}/utilities $OPT
    cp makefile* ${DirName} $OPT
    cp input/* ${DirName}/input $OPT
    if [ -e gen ]; then
        cp gen ${DirName} $OPT
    fi
}

GetLastLogID () {
    local recordFile=$1
    if [ ! -e .log ]; then
        mkdir .log
    fi

    if [ ! -e .log/${recordFile} ]; then
        touch .log/${recordFile} 
        return 0
    fi

    local i=0

    numLog=`ls .log/[0-9]*log`
    if [ "$numLog" != "" ]; then
        local IDList1=`ls .log/[0-9]*log | cut -d "/" -f 2 | cut -d "." -f 1`
    fi

    local IDList2=`grep -n "JobID" .log/${recordFile} | cut -d " " -f 2`
    maxID1=0
    maxID2=0

    for i in $IDList1
    do
        if [ $i -gt $maxID1 ]; then
            maxID1=$i
        fi 
    done
   
    for i in $IDList2
    do
        if [ $i -gt $maxID2 ]; then
            maxID2=$i
        fi 
    done

    if [ $maxID1 -ge $maxID2 ]; then
    return $maxID1
    fi
    return $maxID2
}

basename=paradis
recordFile=history.log
logID=0
cpOpt=-rf
numbers=""
baseJobName=WLY
jobMes=""

dateTime=`date "+%Y-%m-%d %H:%M:%S"`
currentDir=`pwd`

ARGS=`getopt -o hr:o:b:n:m:j:x --long record:,cpopt:,basename:,numbers:,number:,message:,jobmes:,basejobname -n 'example.sh' -- "$@"`
if [ $? != 0 ]; then
     echo "Terminating..."
     exit 1
fi
eval set -- "${ARGS}"

while true
do
#    echo "first $1, second is $2"
    case "$1" in
        -h|--help)
            HelpMessages;
            exit 1
            shift
            ;;
        -r|--record)
            recordFile=$2
            shift 2
            ;;
        -o|--cpopt)
            cpOpt="-$2"
            shift 2
            ;;
        -b|--basename)
            basename=$2
            shift 2
            ;;
        -n|--numbers|--number)            
            numbers="$2"
            numbers=${numbers//,/ }
            shift 2
            ;;
        -m|--message)
            note="$2"
            shift 2
            ;;
        -x|--basejobname)
            baseJobName="XJ"
            shift 
            ;;
        -j|--jobmes)
            jobMes="$2"
            shift 2
            ;;
         --)
            shift
            break
            ;;
         *)
            echo "Internal error"
            exit 1
            ;;
    esac
done

GetLastLogID $recordFile
logID=`expr $? + 1`

logFile=.log/${logID}.log
if [ ! -e .log/${logID}.log ];then
    touch .log/${logID}.log
fi

printf "JobID: %06d" ${logID} >> $logFile
echo -n " { $dateTime @@@ copy the codes into ${basename}" >> $logFile

lineNumber=`grep  -n "recordFile=" $baseJobName | cut -d : -f 1`
sed -i "${lineNumber}d" $baseJobName
sed -i "${lineNumber}irecordFile=${currentDir}/.log/${recordFile}" $baseJobName

lineNumber=`grep  -n "logFile=" $baseJobName | cut -d : -f 1`
sed -i "${lineNumber}d" $baseJobName
sed -i "${lineNumber}ilogFile=${currentDir}/${logFile}" $baseJobName

firstNumber=yes
for number in $numbers $basename
do
    if [ ${firstNumber} = "yes" -a $basename = $number ]; then
        if [ ! -d "../${basename}" ] ; then
            mkdir ../${basename}
        fi

#        cp * ../${basename} $cpOpt
#        rm ../${basename}/sc -f
#        rm ../${basename}/${recordFile} -f
        
        CopyCodes "../${basename}" $cpOpt
        cp ${baseJobName} ../${basename}/${baseJobName}.${jobMes} $cpOpt
        firstNumber=no
        continue
    fi
    
    if [ $basename != $number ]; then
        if [ ! -d "../${basename}${number}" ] ; then
            mkdir ../${basename}${number}
        fi

        echo -n " ${number}" >> ${logFile}

        CopyCodes "../${basename}${number}" $cpOpt
        cp ${baseJobName} ../${basename}${number}/${baseJobName}.${jobMes}.${number} $cpOpt
    fi
    firstNumber=no
done
echo "" >> ${logFile}


echo  "Job  Message: base ${baseJobName}, job ${jobMes}" >> $logFile
lastGitLog2=`git log -1 --oneline`
lastGitLog1=`git symbolic-ref --short -q HEAD`

echo  "Last git log: ${lastGitLog1} - ${lastGitLog2}" >> $logFile
if [ "$note" !=  "" ] ; then
    echo  "Modification: $note" >> ${logFile}
fi

