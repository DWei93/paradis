###########################################################################
#
#	Define the source/object modules for the ctablegen utility
#
###########################################################################

CTABLEGEN_SRCS = CTableGen.C             \
                 CorrectionTable.C       \
                 FindPreciseGlidePlane.C \
                 FMSigma2.C              \
                 FMSupport.C             \
