PARADIS_OBJS = $(PARADIS_C_SRCS:.c=.o)  $(PARADIS_CPP_SRCS:.cc=.o) 


###########################################################################
#
#	Define the source/object modules for the ctablegen utility
#
###########################################################################

CTABLEGEN_SRCS = CTableGen.cc             \
                 CorrectionTable.cc       \
                 FindPreciseGlidePlane.cc \
                 FMSigma2.cc              \
                 FMSupport.cc             \
                 Matrix.cc                \
                 Heap.cc                  \
                 MemCheck.cc              \
                 PickScrewGlidePlane.cc   \
                 QueueOps.cc              \
                 Util.cc				   \
      			 Math.cc	               \
				 Grain.cc	

CTABLEGEN_OBJS = $(CTABLEGEN_SRCS:.cc=.o)
