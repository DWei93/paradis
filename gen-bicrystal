#!/bin/bash

######################################################################################
#
#                     Script of  Generation of FCC FR source 
#    The default orientation of cell is
#                      | Normalize[{ 1,-1, 0}] |
#                      | Normalize[{ 1, 1, 1}] |
#                      | Normalize[{-1,-1, 2}] |
#    which is matrix orientation of PBC polycrystal with twin. 
#    if you want to change the orientation of simulation cell, you can use follwing
#    two ways:
#      (1)  <-xMatDir ux,uy,uz -yMatDir vx,vy,vz> or
#           <-zMatDir wx,wy,wz -yMatDir vx,vy,vz> or
#           <-zMatDir wx,wy,wz -xMatDir ux,uy,uz> 
#           we just need two directions of axis.
#      (2)  <-TBAngle angle(radian system)>
#           TBAngle is the angle between Z axis and normal of ABC glide plane, if
#	    twin exist, the normal of ABC represent TB plane. Besides, the another
#           two independ variables in rotate matrix is random.
#    if the above two ways are both in command line, first one is default.
#    $1 is the type of simulation, $2 is randm seed.
#                    
######################################################################################

#frlen=00
ctrlFile=Copper.ctrl
cubeln=5000
if [ $cubeln -ge 3000 ]; then heightRatio=1; else heightRatio=2; fi
cubel=`echo ${cubeln}/0.256 | bc`
frlen=`echo ${cubel}/3 | bc`
maxSeg=`echo ${cubel}/15 |bc `
nGrains=2
thick=`echo ${cubel}/${nGrains}| bc`
thickn=`echo "scale=0; (${cubeln}/${nGrains})/1" |bc`
echo "Thickness=$thick b, $thickn nm"
nfrs=500; maxDensity=5E12;
polycrystal=${1}
single=${2}

msize=`echo "scale=0; ${cubel}/21" | bc`
sed -i "/meshSizeX/cmeshSizeX = $msize" $ctrlFile;
sed -i "/meshSizeY/cmeshSizeY = $msize" $ctrlFile;
sed -i "/meshSizeZ/cmeshSizeZ = $msize" $ctrlFile;

if [ $cubeln -le 500 ]; then nfrs=23; maxDensity=5E12; fi;
if [ $cubeln -eq 750 ]; then nfrs=24; maxDensity=6E12; fi;

PI=3.1415926535897932385
if [ ${polycrystal} == "1" ]; then
    srctype=5
    angle=`echo "scale=16; ${2}.0 * ${PI} / 180.0 " | bc -l`
    sed -i "/dirname/cdirname = \"res.bicrtal-d-${cubeln}nm-${2}-degree-$3\"" ${ctrlFile}
    sed -i "/grainSize/cgrainSize = ${thick}" ${ctrlFile}
else
    degree=`sed -n '1p' ${3}`
    sed -i "/dirname/cdirname = \"res.single-${single}-d-${cubeln}nm-${degree}\"" ${ctrlFile}
    sed -i "/grainSize/cgrainSize = ${cubel}" ${ctrlFile}
    srctype=2
    if [ ${single} = "1" ]; then
        lnum=`grep  -n "basis orientation:" ${3} | cut -d : -f 1`
    else
        lnum=`grep  -n "twin orientation:" ${3} | cut -d : -f 1`
    fi

    echo "num=$lnum"
    let lnum=$lnum+1
    l1=`sed -n "${lnum}p" ${3}`
    x1=`echo ${l1} | cut -d " " -f 2 `
    x2=`echo ${l1} | cut -d " " -f 3 `
    x3=`echo ${l1} | cut -d " " -f 4 | cut -d "}" -f 1`
    let lnum=$lnum+1
    l2=`sed -n "${lnum}p" ${3}`
    y1=`echo ${l2} | cut -d " " -f 2 `
    y2=`echo ${l2} | cut -d " " -f 3 `
    y3=`echo ${l2} | cut -d " " -f 4 | cut -d "}" -f 1`

    xdir=`echo "${x1}${x2}${x3}"`
    ydir=`echo "${y1}${y2}${y3}"`

fi

case $srctype in
######################################################################################
#
#    Type I: oringin code, PBC
#
######################################################################################
    1|I)
    ./bin/paradisgen -type 3  -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs}  \
    -polycrystal 0  -pbc 0 -extend 0  -srcLenType 0 \
    -xMatDir 1,0,0 -zMatDir 0,0,1 ;;

#    -polycrystal 0 -pbc 0 \
######################################################################################
#
#    Type II: free surface, single crystal, gradient sources distribution
#
######################################################################################
    2|II)
    ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed \
    -polycrystal 0 -pbc 7 \
    -xMatDir ${xdir} -yMatDir ${ydir} -maxDisDen ${maxDensity} \
    -heightRatio ${heightRatio} -deltaNums 0 -nLayers 1 ;;

#    -xMatDir 1,0,0 -yMatDir 0,1,0 \
#    -polycrystal 0 -pbc 7 -extended 4\

######################################################################################
#    
#    Type III: polycrystal, only have grain boundaries.
#    ./bin/paradisgen -type 3 -frlen 2000 -cubel 4000 -maxseg 100 -nfrsrcs 10 $seed \
#    -polycrystal 1 -nGrain 1 -pbc 0 \
#    -xMatDir 1,0,0 -yMatDir 0,1,0 ;; 
#    
######################################################################################
    3|III)
    echo "can not suppose this type" 
    exit 1 ;;

######################################################################################
#    
#    Type IV: polycrystal with twin, PBC, simulate RVE
# 
######################################################################################
    4|IV)
    ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed \
    -polycrystal 1 -nGrain ${nGrains}  -pbc 0 -nTDs 1 -maxDensity $maxDensity -gb 1 ;;
#   -polycrystal 1 -nGrain ${nGrains}  -pbc 0  ;;
#   -polycrystal 1 -nGrain 2  -pbc 0 -nTDs 1 -gb 1;;
#   -burgID 5 -planeID 1 \
######################################################################################
#    
#    Type V: bicrystal with twin boundary, simulate sample
#
######################################################################################
    5|V)

    (echo "${2}-degree" ; ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed \
    -polycrystal 1 -nGrain 2 -pbc 7 -maxDensity $maxDensity \
    -TBAngle ${angle} -twinRatio 0.5 -heightRatio ${heightRatio} -deltaNum 0 -nLayers 1 )| tee createFR.log;;

#    -xMatDir ${xdir} -yMatDir ${ydir} -twinRatio 0.5 -heightRatio 2 -deltaNum 0 -nLayers 1;;
#    -twinRatio 0.5 -heightRatio 1 -deltaNum 0 -nLayers 1 ;;
#    -xMatDir 0.707106781186548,-0.707106781186548,0.0 -yMatDir 0.642228525188087,0.642228525188087,-0.418431646591735 \
    *)
     echo "input error!"
     exit 1 ;;
esac

./bin/paradisrepart -infile paradis.data -cells 4 -domains 2,2,1 -outfile Copper.data 
cp Copper.data input/Copper.data
echo "cp Copper.data > input/Copper.data"
