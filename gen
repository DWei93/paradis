#!/bin/bash

######################################################################################
#
#                     Script of  Generation of FCC FR source 
#    The default orientation of cell is
#                      | Normalize[{ -1,  1, 0}] | = AB
#                      | Normalize[{ -1, -1, 2}] | = C\delta
#                      | Normalize[{  1,  1, 1}] | = D\delta = TB normal
#
#    For multulayer PBC cells, the default orientaion should be rotated 5 degree with D\delta to
#    remove border annihiation effectes of effects of non-TB slip systems
#    if you want to change the orientation of simulation cell, you can use follwing
#    two ways:
#      (1)  <-xMatDir ux,uy,uz -yMatDir vx,vy,vz> or
#           <-zMatDir wx,wy,wz -yMatDir vx,vy,vz> or
#           <-zMatDir wx,wy,wz -xMatDir ux,uy,uz> 
#           we just need two directions of axis.
#      (2)  <-rotate rotAngle,rotDir[0],rotDir[1],rotDirp[2]>
#           We can rotate the local coordinate system again based on the matrix orientation of (1)
#                    
######################################################################################

core=1.0
mu=48.0
PI=3.1415926535897932385
ctrlFile=input/Copper.ctrl
logFile=input/CreateFR.log
thickn=500
if [ $# -gt 1 ] ; then thickn=$2; fi
#frlen=`echo ${cubel}/2 | bc`
poly=1
nGrains=2
if [ $# -gt 2 ] ; then nGrains=$3; fi
nTDs=1
gb=0
nfrs=18
nMesh=41
nfrsPerGrain=12000
nTimesThick1=3
eRate=5000
sed -i "/^eRate/ceRate = $eRate" $ctrlFile
nTimesThick2=3
cubeln=`echo "${nGrains}*${thickn}" | bc`
cubel=`echo "${cubeln}/0.2556" | bc`
#nfrs=`echo "24*${nGrains}" | bc`
nfrs=`echo "${nfrsPerGrain}*${nGrains}" | bc`
thick=`echo ${cubel}/${nGrains}| bc`
frlen=`echo ${thick}*${nTimesThick1} | bc`,`echo ${thick}*${nTimesThick2} | bc`
frlen=3

maxSeg1=`echo ${cubel}/20 | bc `
maxSeg2=`echo ${thick}/5 | bc `
if [ ${maxSeg1} -gt ${maxSeg2} ]; then maxSeg=${maxSeg2}; else maxSeg=${maxSeg1}; fi
rTol=`echo "scale=7;${maxSeg}*sqrt(2)/32" | bc -l`
rc=`echo "scale=7;0.1+4.0*${rTol}" | bc -l`
thickn=`echo "scale=0; (${cubeln}/${nGrains})/1" |bc`

#maxDensity=`echo "scale=5;480/${thickn}" |bc -l`E13
maxDensity=5.0E13
#tdDensity=-1

minDT=`echo "scale=3; 2.0*${rTol}/0.63771517" | bc`E-13

echo "Thickness=$thick b, $thickn nm, ${nGrains} grains,  maxSeg=${maxSeg}b, rTol =$rTol, minDT=$minDT, maxDensity=$maxDensity, rc=$rc"
sed -i "/grainSize/cgrainSize = ${thick}" ${ctrlFile}
sed -i "/^rTol =/crTol = ${rTol}" $ctrlFile
sed -i "/^rc =/crc = ${rc}" $ctrlFile
sed -i "/^minDT =/cminDT = ${minDT}" $ctrlFile
#sed -i "/dirname/cdirname = \"res.relax-t-${thickn}nm\"" ${ctrlFile}
maxDT=`echo "scale=3; ${thickn}/4*5000/${eRate}" | bc -l`E-13
sed -i "/^maxDT/cmaxDT = ${maxDT}" $ctrlFile;

ecore=`echo "scale=7;(${mu}/(4.0*${PI}))*l(${rc}/${core})" | bc -l`E9
sed -i "/^Ecore =/cEcore = ${ecore}" $ctrlFile
sed -i "/^shearModulus =/cshearModulus = ${mu}E9" $ctrlFile

amu=90
polar=90
point=23

if [[ $# -ge 4 ]]; then 
    nGrains=$4; 
    tdDensity=2.0E6
    tdLength=3
else
    tdDensity=-1
    tdLength=`echo "scale=3;$thick" | bc -l`
fi

if [[ `sed -n "/^loadType/p" $ctrlFile | cut -d " " -f 3` != "6" ]]; then 
    if [ $# -gt 0 ]; then 
        line=`sed -n "${1}p" data`; 
        polar=`echo ${line} | cut -d " " -f 7`; 
        amu=`echo ${line} | cut -d " " -f 8`; 
        echo "edotPolar = [$polar $amu]" ; 
        sed -i "/^edotPolar =/cedotPolar = [ $polar $amu ]" $ctrlFile; 
        point=$1; 
    fi
    loadDir=${polar},${amu}
else
    loadDir=0,0,0,0,1,0
    echo "loadType=6: $loadDir"
fi

sed -i "/meshNumX/cmeshNumX = $nMesh" $ctrlFile;
sed -i "/meshNumY/cmeshNumY = $nMesh" $ctrlFile;
sed -i "/meshNumZ/cmeshNumZ = $nMesh" $ctrlFile;

polycrystal=1
single=2

srctype=4
case $srctype in
######################################################################################
#
#    Type I: oringin code, PBC
#
######################################################################################
    1|I)
    ./bin/paradisgen -type 3  -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs}  -frlen ${frlen} \
    -polycrystal 0  -pbc 0 -extend 0  -srcLenType 0 -maxDensity ${maxDensity} \
    -xMatDir 1,0,0 -yMatDir 0,1,0 ;;

#   -xMatDir 0.788675134594813,-0.577350269189626,-0.211324865405187 \
#   -yMatDir -0.211324865405187,-0.577350269189626,0.788675134594813 ;;

#    -polycrystal 0 -pbc 0 \
######################################################################################
#
#    Type II: free surface, single crystal, gradient sources distribution
#
######################################################################################
    2|II)
    ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed \
    -polycrystal 0 -pbc 7 \
    -xMatDir ${xdir} -yMatDir ${ydir} -maxDisDen ${maxDensity} \
    -heightRatio 2 -deltaNums 0 -nLayers 1 ;;

#    -xMatDir 1,0,0 -yMatDir 0,1,0 \
#    -polycrystal 0 -pbc 7 -extended 4\

######################################################################################
#    
#    Type III: polycrystal, only have grain boundaries.
#    ./bin/paradisgen -type 3 -frlen 2000 -cubel 4000 -maxseg 100 -nfrsrcs 10 $seed \
#    -polycrystal 1 -nGrain 1 -pbc 0 \
#    -xMatDir 1,0,0 -yMatDir 0,1,0 ;; 
#    
######################################################################################
    3|III)
    echo "can not suppose this type" 
    exit 1 ;;

######################################################################################
#    
#    Type IV: polycrystal with twin, PBC, simulate RVE
# 
######################################################################################
    4|IV)
    info=`echo "./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed  -tdDensity ${tdDensity} \
    -polycrystal ${poly} -nGrain ${nGrains}  -pbc 0 -nTDs ${nTDs} -maxDensity $maxDensity -gb ${gb} -loadDir ${loadDir} \
    -tdLength $tdLength"`

    ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed -tdDensity ${tdDensity}  -tdLength $tdLength \
    -polycrystal ${poly} -nGrain ${nGrains}  -pbc 0 -nTDs ${nTDs} -maxDensity $maxDensity -gb ${gb} -loadDir ${loadDir} | tee $logFile ;

    echo "$info"
    echo "$info" >> $logFile;;
#   -polycrystal ${poly} -nGrain ${nGrains}  -pbc 0 -nTDs ${nTDs} -maxDensity $maxDensity -gb ${gb} -loadDir ${loadDir} | tee $logFile ;;
#   -polycrystal 1 -nGrain ${nGrains}  -pbc 0  ;;
#   -polycrystal 1 -nGrain 2  -pbc 0 -nTDs 1 -gb 1;;
#   -burgID 5 -planeID 1 \
######################################################################################
#    
#    Type V: bicrystal with twin boundary, simulate sample
#
######################################################################################
    5|V)

    ./bin/paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed \
    -polycrystal 0 -nGrain 1 -pbc 7 -maxDensity $maxDensity -tdDensity ${tdDensity} \
    -TBAngle ${angle} -twinRatio 0.5 -heightRatio 2 -deltaNum 0 -nLayers 1 ;;

#    -xMatDir ${xdir} -yMatDir ${ydir} -twinRatio 0.5 -heightRatio 2 -deltaNum 0 -nLayers 1;;
#    -twinRatio 0.5 -heightRatio 1 -deltaNum 0 -nLayers 1 ;;
#    -xMatDir 0.707106781186548,-0.707106781186548,0.0 -yMatDir 0.642228525188087,0.642228525188087,-0.418431646591735 \
    *)
     echo "input error!"
     exit 1 ;;
esac

percentage=`cat $logFile | grep "%" | cut -d "%" -f 1`
finish=`echo "${percentage}>5.0" | bc`
if [[ ${finish} -eq 0 ]] ; 
    then ./gen $point $thickn $nGrains; 
else
    nodeCount=`cat $logFile | grep "Total node count" | cut -d ":" -f 2`
    if [[ `echo "${nodeCount}>8000" | bc` -eq 1 ]] ; then ncells=16;
    elif [[ `echo "${nodeCount}>4000" | bc` -eq 1 ]] ; then ncells=8;
    else ncells=4; fi
    sed -i "/^numXcells/cnumXcells = $ncells" $ctrlFile
    sed -i "/^numYcells/cnumYcells = $ncells" $ctrlFile
    sed -i "/^numZcells/cnumZcells = $ncells" $ctrlFile

    ./bin/paradisrepart -infile paradis.data -cells 4 -domains 2,2,1 -outfile Copper.data 
    sed -i "1i# ${percentage}% of primary srcs" Copper.data
    info="# paradisgen -type 3 -frlen ${frlen} -cubel ${cubel} -maxseg ${maxSeg} -nfrsrcs ${nfrs} $seed -polycrystal 1 -nGrain ${nGrains}  -pbc 0 -nTDs ${nTDs} -maxDensity $maxDensity -gb ${gb} -loadDir $polar,$amu"
    sed -i "1i$info" Copper.data
    sed -i "1i#`date`" Copper.data
    cp Copper.data input/Copper.data
    echo "cp Copper.data > input/Copper.data"
fi
