#
#  This is a sample control file using the general FCC mobility and
#  the FMM for far-field forces to simulate dislocations in a sample
#  of copper.  This examples runs on 8 processors and requires
#  the FMM correction table fm-ctab.Cu.m2.t5.dat.  If the
#  correction table has not been provided in the "inputs" directory,
#  See the description of 'ctablegen' in the 'Tools' section of
#  the ParaDiS User's Guide for information on generating correction tables.
#
#  Output generated by this example will be placed under the directory
#    restart files
#    gnuplot visualization files
#    various properties files
#    segment velocity files
#    flux decomposition files
#
#
#  Domain geometry
#
numXdoms = 2
numYdoms = 2
numZdoms = 2
#
#  Cell geometry
#
numXcells = 4
numYcells = 4
numZcells = 4

#
# Mesh size for tecmesh
#
meshSizeX = 355
meshSizeY = 355
meshSizeZ = 355

#  Dynamic load balancing
#
decompType = 2
DLBfreq = 3
#
#  Discretization and topological change controls
elasticinteraction = 1
a0 = [ 1.68098 1.12421 1.01163 0.187646 ]
enableCrossSlip =   1
rTol = 11.1422881
rc =  200
grainSize = 1956
dirname = "res.EM-l-1000nm"
remeshRule = 2
enforceGlidePlanes =  1
splitMultiNodeFreq =   1  
#
#  Simulation time and timestepping controls
#  
maxstep =  40000000 
#maxstep =  20000
maxStn = 7.0E-2
maxPst = 5.0E-3
timestepIntegrator =   "trapezoid"
nextDT = 1.0e-13
wallTime = 24
#
#  Fast Multipole Method controls
#  
fmEnabled =   1  
fmMPOrder =   2  
fmTaylorOrder =   5  
fmCorrectionTbl =   "fm-ctab.Cu.m2.t5.dat"
#
#  Loading conditions
#  
loadType = 1
indxErate = 8
eRate =   5.0E3
#eRate =  0.0E0
strRate = -4.0E16
#strRate = 0.0
#plaRateCtr = 2.0E4

edotPolar = [ 45.0 90.0 ]

appliedStress = [
	0.0e0
	0.0e0
	0.0e0
	0.0e0
	0.0e0
	0.0e0
]

#
#  Material and mobility parameters
#  
mobilityLaw =   "Wei"  
#shearModulus =   54.6e9  # Voight Average
shearModulus =  46.554e9  # in jin paper
gbStrength = -1
tbStrength = [
    245.0E6
    700.0E6 
]
burgMag =   2.55600e-10 
pois = 3.240000e-01

#fricStress = 3.46e7
#  mobility values may be a little low for FCC
#MobScrew =   6.4102600e+04
#MobEdge =    6.4102600e+04  
#MobTwinning = 6.4102600e+04

sfEnergy = 29.498E-3    # J.m^-1
# Radom Interal stree field
randomInternalForce = 0

#
#  I/O controls and parameters
#  
#
tecplot = 1
tecplotfreq = 2000
saveprop = 1
savepropfreq = 200
tecmesh = 1
tecmeshfreq = 10000000
savecn = 1
savecnfreq = 10000
savetimers = 0
savetimersfreq = 10
velfile = 0
velfilefreq = 1000
minDT = 1.0E-12
